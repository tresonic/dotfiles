#!/usr/bin/env bash
# Switch default audio output with tofi.
# Lists every sink, plus any *other* available HDMI/DP outputs on the GPU card
# (picking one of those switches the card profile first).
# Deps: libpulse (pactl), jq, tofi, libnotify (optional)

set -euo pipefail

# Find yours with: pactl list cards short
CARD="alsa_card.pci-0000_03_00.1"

default=$(pactl get-default-sink)
sinks=$(pactl -f json list sinks)
cards=$(pactl -f json list cards)

# Each line: label <TAB> type <TAB> arg1 [<TAB> arg2]
entries=$(
    {
        # Normal sinks; current default marked with "* "
        jq -r --arg def "$default" '
            .[] | [(if .name == $def then "* " else "  " end) + .description,
                   "sink", .name] | @tsv
        ' <<<"$sinks"

        # Available HDMI stereo profiles on the GPU card that aren't active
        jq -r --arg card "$CARD" '
            .[] | select(.name == $card) | .active_profile as $act
            | .profiles | to_entries[]
            | select(.key | startswith("output:hdmi-stereo"))
            | select((.value.available | tostring) as $a | $a == "true" or $a == "yes")
            | select(.key != $act)
            | ["  GPU: " + (.value.description | sub(" Output$"; "")),
               "profile", $card, .key] | @tsv
        ' <<<"$cards"
    }
)

choice=$(cut -f1 <<<"$entries" | tofi --prompt-text "output: ") || exit 0

line=$(awk -F'\t' -v c="$choice" '$1 == c' <<<"$entries" | head -n1)
[ -n "$line" ] || exit 1

IFS=$'\t' read -r label type arg1 arg2 <<<"$line"

case $type in
    sink)
        sink=$arg1
        ;;
    profile)
        pactl set-card-profile "$arg1" "$arg2"
        # Wait for the new sink to appear
        sink=""
        for _ in $(seq 30); do
            sink=$(pactl -f json list sinks | jq -r --arg card "$arg1" --arg prof "$arg2" '
                ("alsa_output." + ($card | sub("^alsa_card\\."; ""))
                 + "." + ($prof | sub("^output:"; ""))) as $prefix
                | .[] | select(.name | startswith($prefix)) | .name
            ' | head -n1)
            [ -n "$sink" ] && break
            sleep 0.1
        done
        [ -n "$sink" ] || { notify-send "Audio output" "Sink didn't appear after profile switch"; exit 1; }
        ;;
    *)
        exit 1
        ;;
esac

pactl set-default-sink "$sink"

# Move already-playing streams to the new sink
pactl list short sink-inputs | cut -f1 | while read -r id; do
    pactl move-sink-input "$id" "$sink" || true
done

desc=$(pactl -f json list sinks | jq -r --arg n "$sink" '.[] | select(.name == $n) | .description')
command -v notify-send >/dev/null && notify-send -t 2000 "Audio output" "$desc"
